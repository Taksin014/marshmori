{
  "name": "marshmori",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.6.1",
  "type": "module",
  "description": "Marshmori (Mamori) — a tiny marshmallow sprout at the top of your Windows screen that watches Claude Code, Codex and Antigravity, and stretches its neck to your mouse when they need you.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "hook": "cargo build --release -p marshmori-hook",
    "predev": "npm run hook",
    "prebuild": "npm run hook",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "three": "^0.180.0"
  }
}
